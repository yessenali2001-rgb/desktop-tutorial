# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# WhatsApp Cloud API (Meta for Developers -> ваше приложение -> WhatsApp -> API Setup)
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Любая строка — её же вводите в поле "Verify token" при настройке вебхука
WHATSAPP_VERIFY_TOKEN=my-secret-verify-token
# App Secret (App settings -> Basic) — для проверки подписи входящих запросов
WHATSAPP_APP_SECRET=

# Необязательно
PORT=3000
GRAPH_API_VERSION=v23.0
# Свой системный промпт (если пусто — встроенный промпт консультанта по робототехнике)
SYSTEM_PROMPT=
